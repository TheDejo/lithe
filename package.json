{
  "name": "@thedejo/lithe",
  "version": "0.2.0",
  "description": "Jest-style test runner for AI agents",
  "main": "dist/index.js",
  "bin": {
    "lithe": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node dist/cli/index.js && node --test test/cli.integration.mjs",
    "dev": "tsx src/cli/index.ts"
  },
  "keywords": [
    "ai",
    "llm",
    "testing",
    "agents",
    "jest"
  ],
  "author": "Dejo",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.4.5",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "tsx": "^4.23.15"
  },
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheDejo/lithe.git"
  }
}
